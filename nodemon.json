{
  "watch": [
    "index.js",
    "src/**/*.js",
    "config/**/*.json",
    ".env"
  ],
  "ignore": [
    "sessions/**/*",
    "logs/**/*",
    "node_modules/**/*",
    ".git/**/*",
    "**/*.json~",
    "device-status.json",
    "session-state.json",
    "data/**/*",
    "archive/**/*",
    "docs/**/*",
    "tests/**/*"
  ],
  "delay": 2000,
  "env": {
    "NODE_ENV": "development"
  },
  "ext": "js,json",
  "exec": "node index.js",
  "events": {
    "restart": "echo '🔄 Bot restarting...'",
    "crash": "echo '💥 Bot crashed!'"
  },
  "quiet": false,
  "verbose": false
}
