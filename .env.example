# WhatsApp Bot Linda - Environment Configuration
# 
# ⚠️ CRITICAL SECURITY NOTICE:
# ==============================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in YOUR actual values
# 3. NEVER commit .env to git (already in .gitignore)
# 4. NEVER share .env with anyone
# 5. NEVER commit credentials/passwords to version control
# 6. Rotate credentials after any potential exposure
# ==============================================================

# ==========================================
# BOT CONFIGURATION
# ==========================================
NODE_ENV=development
LOG_LEVEL=debug
DEBUG_MODE=true

# ==========================================
# WHATSAPP BOT SETTINGS
# ==========================================
# Master bot number (Main instance)
# Format: 971505760056 (without + or spaces)
BOT_MASTER_NUMBER=your_master_whatsapp_number_here
BOT_ENABLE_PAIRING_CODE=true
# Auto-link master account on startup if no session exists (true = auto-link, false = manual via 'link master')
AUTO_LINK=true
# Preferred auto-linking method: "code" (default/preferred) or "qr" (on request)
AUTO_LINK_METHOD=code
# Use terminal commands link-code or link-qr for a single linking attempt.
BOT_SESSION_STORE_PATH=./sessions

# ==========================================
# PUPPETEER/CHROME CONFIGURATION
# ==========================================
PUPPETEER_EXECUTABLE_PATH=
CHROME_BIN=
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_HEADLESS=true

# ==========================================
# LINDA GOOGLE SERVICE ACCOUNTS - COPY SECTION START
# ==========================================
# Copy through COPY SECTION END into secrets\.env, keeping CRM settings.
# If a variable already exists there, update it instead of adding a duplicate.
# Empty keys mean NOT CONFIGURED; replace them when your fresh keys are ready.
#
# KEY SETUP (repeat separately for each account you intend to enable):
# 1. In the correct Google Cloud project, select the intended service account.
#    If permitted by your organization, create/download a fresh JSON key via
#    IAM & Admin > Service Accounts > account > Keys > Add key > Create new key.
#    Do not reuse the Firebase key that failed authentication.
# 2. Store the downloaded JSON locally under the ignored secrets folder.
#    A service-account JSON includes type=service_account, project_id,
#    client_email and private_key. OAuth client secrets/API keys are different.
# 3. In PowerShell, encode the ENTIRE JSON file onto one line:
#    [Convert]::ToBase64String([IO.File]::ReadAllBytes((Resolve-Path 'secrets\poweragent-key.json').Path)) | Set-Clipboard
#    Paste the clipboard into GOOGLE_ACCOUNT_POWERAGENT_KEYS_BASE64 below.
#    Repeat with your Goraha JSON path for GOOGLE_ACCOUNT_GORAHA_KEYS_BASE64.
#    For Akoya automation, repeat with the serviceman11 JSON path.
# 4. Enable Google Sheets API and Google Drive API in each applicable project.
#    Share each target spreadsheet/folder with that JSON's client_email.
#    Viewer permits reads; Editor is needed for intended writes.
#    A service account does not automatically inherit your personal Drive files
#    or contacts. Personal Contacts access requires separate authorization.
#
# SECURITY: Base64 is encoding, NOT encryption. Keep populated values and JSON
# files out of Git and chat. Git-ignore does not undo previous exposure.
# This example must remain blank; real credentials belong only in secrets\.env.

# Account 1: PowerAgent - Sheets/Drive service-account credentials
GOOGLE_ACCOUNT_POWERAGENT_KEYS_BASE64=

# Account 2: Goraha - separate service-account credentials
GOOGLE_ACCOUNT_GORAHA_KEYS_BASE64=

# Account 3: serviceman11 - optional, required by Akoya sheet validation
# Only uncomment when configuring Akoya; otherwise leave this disabled.
# GOOGLE_ACCOUNT_SERVICEMAN11_KEYS_BASE64=
# AKOYA_ORGANIZED_SHEET_ID=
# Use the ID between /d/ and /edit in the spreadsheet URL, not the full URL.
# That variable also appears in DATABASE CONTEXT below; keep one assignment.

# LOAD AND CHECK (run from the project root in PowerShell):
# $env:DOTENV_CONFIG_PATH = Join-Path $PWD 'secrets\.env'
# npm run doctor:google -- --offline
# npm run doctor:google
# Offline checks discover keys and validate their required JSON fields.
# Online checks request a real Google token; they do not edit Google data.
# Token success does NOT prove access to a particular spreadsheet or Contacts.
# After successful checks, restart Linda from the same PowerShell environment:
# npm run dev
#
# LINDA GOOGLE SERVICE ACCOUNTS - COPY SECTION END
# ==========================================

# Contact Sync Settings
GOOGLE_CONTACTS_SYNC_INTERVAL=3600000
GOOGLE_CONTACTS_PHONE_PREFIX=971
GOOGLE_CONTACTS_DEDUPLICATE=true
GOOGLE_CONTACTS_AUTO_SYNC=false

# Legacy paths (DEPRECATED - DO NOT USE)
# These are kept ONLY for backward compatibility
# GoogleServiceAccountManager prefers base64 variables above
# GOOGLE_ACCOUNT_POWERAGENT_KEYS=./config/google/keys.json
# GOOGLE_ACCOUNT_GORAHA_KEYS=./config/google/keys-goraha.json
# GOOGLE_SHEETS_KEY_PATH=./config/google/keys.json
# GOOGLE_CREDENTIALS_PATH=./config/google/keys.json

# Sheet configuration
GOOGLE_SHEET_ID=your_spreadsheet_id_here
LOG_FILE=./logs/google-api.log

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB Atlas Connection String Format:
# mongodb+srv://username:password@host/database?retryWrites=true&w=majority
# Get from MongoDB Atlas > Connect > Connection String
MONGODB_URI=mongodb+srv://username:password@yourhost.mongodb.net/databasename?retryWrites=true&w=majority
DB_PASSWORD=your_database_password_here
DATABASE_URL=mongodb+srv://username:password@yourhost.mongodb.net/databasename?retryWrites=true&w=majority

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
HOST=localhost
API_ACCESS_TOKEN=
# Optional tokens with restricted access; each must be distinct and at least 32 characters.
API_READ_TOKEN=
API_MESSAGING_TOKEN=
# Comma-separated exact origins allowed to access the API from browsers.
# Leave empty when no browser-based cross-origin client is needed.
API_CORS_ORIGINS=

# API queue worker (runs inside the bot, not the API server).
# Delivers messages the REST API queued in CommunicationLog through the master account.
# Off by default so an old backlog is never sent by surprise. Set to 1 to enable.
API_QUEUE_WORKER=0
# Random wait between sends, in seconds (minimum 3). One message per tick.
API_QUEUE_MIN_INTERVAL_SEC=30
API_QUEUE_MAX_INTERVAL_SEC=90
# Queued messages overdue by more than this are cancelled (errorCode EXPIRED) instead of sent.
API_QUEUE_MAX_AGE_HOURS=24

# Working hours: the only daily window in which Linda sends messages
# (terminal campaigns, the API queue worker and the legacy scheduler).
# Format "9", "09:30"; end may be "24". Start later than end spans midnight (e.g. 22 to 02).
# Outside the window sending waits; campaigns stay running and can still be paused or stopped.
WORK_HOURS_START=09:00
WORK_HOURS_END=20:00
WORK_HOURS_TIMEZONE=Asia/Dubai

# New-conversation limit: first-ever messages from the master account to numbers it has
# no WhatsApp chat with. Applied to terminal campaigns, the API queue worker and `send`.
# Over the limit, campaigns defer the contact, the API reschedules (or cancels if past
# API_QUEUE_MAX_AGE_HOURS) and terminal `send` refuses. Replies to existing chats are never limited.
# Ledger: data/outreach/new-conversations.json. Month/day use the timezone below.
NEW_CONVERSATIONS_MONTHLY_LIMIT=30
NEW_CONVERSATIONS_DAILY_LIMIT=2
NEW_CONVERSATIONS_ENFORCE=true
# Defaults to WORK_HOURS_TIMEZONE, then Asia/Dubai.
# NEW_CONVERSATIONS_TIMEZONE=Asia/Dubai

# Area owner outreach (`outreach` terminal command): owners Google Sheet.
# Reads Sheet1 plus all cluster tabs; writing the "Linda Outreach" status column
# needs Editor access for the service account.
OUTREACH_SHEET_ID=
OUTREACH_MAIN_TAB=Sheet1
# Google account name from GOOGLE_ACCOUNT_<NAME>_KEYS* above, or a key file path.
OUTREACH_GOOGLE_ACCOUNT=goraha
# OUTREACH_GOOGLE_KEY_FILE=./config/google/keys-goraha.json

# ==========================================
# PRODUCTION SETTINGS (February 2026)
# ==========================================
NODE_ENV=production
LOG_LEVEL=info
DEBUG_MODE=false

# SESSION PERSISTENCE
SESSION_KEEP_ALIVE=true
SESSION_TIMEOUT_MS=0
HEARTBEAT_INTERVAL=120000
HEARTBEAT_METHOD=typing_indicator

# RECONNECTION SETTINGS
RECONNECT_ATTEMPT_LIMIT=999
RESTART_DELAY=3000
EXIT_DELAY=60000
MAX_INIT_ATTEMPTS=3

# ACCOUNT MANAGEMENT
MAX_SIMULTANEOUS_ACCOUNTS=10
ACCOUNT_SEQUENTIAL_DELAY=5000
ACCOUNT_INIT_TIMEOUT=120000

# HEALTH MONITORING
HEALTH_CHECK_INTERVAL=300000
HEALTH_CHECK_TIMEOUT=30000
ENABLE_HEALTH_MONITORING=true

# DATABASE CONTEXT
AKOYA_SHEET_ID=your_akoya_sheet_id
AKOYA_ORGANIZED_SHEET_ID=your_organized_sheet_id

# ==========================================
# CAMPAIGN SETTINGS
# ==========================================
CAMPAIGN_MODE=batch
CAMPAIGN_BATCH_SIZE=50
